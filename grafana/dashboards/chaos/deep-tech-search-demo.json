            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
