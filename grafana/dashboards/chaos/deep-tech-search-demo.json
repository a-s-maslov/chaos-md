{
  "version": 4,
  "schemaVersion": 38,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "nowDelay": "2s"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Отказы",
        "tags": [
          "chaos",
          "event:failure"
        ],
        "matchAny": false,
        "type": "tags"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(115, 191, 105, 1)",
        "name": "Профили нагрузки",
        "tags": [
          "chaos",
          "event:workload"
        ],
        "matchAny": false,
        "type": "tags"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(50, 116, 217, 1)",
        "name": "Управляющие действия",
        "tags": [
          "chaos",
          "event:control"
        ],
        "matchAny": false,
        "type": "tags"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "pluginId": "prometheus",
        "query": "prometheus",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values({__name__=~\"ydb_workload_rps|ydb_partition_observer_up\"}, application)",
        "label": "Application",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      },
      {
        "name": "database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values(kqp_SessionActors_Active{container=\"ydb-dynamic\"}, database)",
        "label": "Database",
        "refresh": 2,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Поисковые запросы и DML, RPS",
      "id": 201,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/fulltext/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/vector/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/hybrid/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ target$/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    6,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DML + проверка"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (scenario) (ydb_workload_rps{application=~\"$application\",scenario=~\"fulltext|vector|hybrid\",statut=\"ok\"})",
          "legendFormat": "{{scenario}}",
          "refId": "A"
        },
        {
          "expr": "sum by (scenario) (ydb_workload_target_rps{application=~\"$application\",scenario=~\"fulltext|vector|hybrid\",statut=\"ok\"})",
          "legendFormat": "{{scenario}} target",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "sum(ydb_workload_rps{application=~\"$application\",scenario=\"dml_check\",statut=\"ok\"})",
          "legendFormat": "DML + проверка",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
