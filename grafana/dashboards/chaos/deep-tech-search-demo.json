{
  "version": 5,
  "schemaVersion": 38,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "nowDelay": "2s"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Отказы",
        "tags": [
          "chaos",
          "event:failure"
        ],
        "matchAny": false,
        "type": "tags"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(115, 191, 105, 1)",
        "name": "Профили нагрузки",
        "tags": [
          "chaos",
          "event:workload"
        ],
        "matchAny": false,
        "type": "tags"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(50, 116, 217, 1)",
        "name": "Управляющие действия",
        "tags": [
          "chaos",
          "event:control"
        ],
        "matchAny": false,
        "type": "tags"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "pluginId": "prometheus",
        "query": "prometheus",
        "label": "Datasource",
        "current": {},
        "hide": 2
      },
      {
        "name": "application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values({__name__=~\"ydb_workload_rps|ydb_partition_observer_up\"}, application)",
        "label": "Application",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 2
      },
      {
        "name": "database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": "label_values(kqp_SessionActors_Active{container=\"ydb-dynamic\"}, database)",
        "label": "Database",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Поисковые запросы и DML, RPS",
      "id": 201,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/fulltext/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/vector/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/hybrid/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ target$/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    6,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DML + проверка"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (scenario) (ydb_workload_rps{application=~\"$application\",scenario=~\"fulltext|vector|hybrid\",statut=\"ok\"})",
          "legendFormat": "{{scenario}}",
          "refId": "A"
        },
        {
          "expr": "sum by (scenario) (ydb_workload_target_rps{application=~\"$application\",scenario=~\"fulltext|vector|hybrid\",statut=\"ok\"})",
          "legendFormat": "{{scenario}} target",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "sum(ydb_workload_rps{application=~\"$application\",scenario=\"dml_check\",statut=\"ok\"})",
          "legendFormat": "DML + проверка",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Задержка p95, мс",
      "id": 202,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 10,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/fulltext/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/vector/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/hybrid/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DML + проверка"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "max by (scenario) (ydb_workload_pct95{application=~\"$application\",scenario=~\"fulltext|vector|hybrid\",statut=\"ok\"})",
          "legendFormat": "{{scenario}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "max(ydb_workload_pct95{application=~\"$application\",scenario=\"dml_check\",statut=\"ok\"})",
          "legendFormat": "DML + проверка",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Ошибки и ретраи, RPS",
      "description": "Ошибки — запросы, окончательно завершившиеся ошибкой. Ретраи — повторные попытки YDB SDK после временных ошибок. Обе серии приведены к операциям в секунду за фактический интервал измерения.",
      "id": 203,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "auto",
            "pointSize": 6,
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "barAlignment": 0,
            "softMax": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/fulltext/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/vector/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/hybrid/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(ydb_workload_error_rps{application=~\"$application\",scenario=~\"fulltext|vector|hybrid|dml_check\"})",
          "legendFormat": "ошибки",
          "refId": "A"
        },
        {
          "expr": "sum(ydb_workload_retry_rps{application=~\"$application\",scenario=~\"fulltext|vector|hybrid|dml_check\"})",
          "legendFormat": "повторные попытки",
          "refId": "B"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$ds"
      },
      "description": "User actor pool utilization divided by the dynamically allocated thread count. Auto-config may change that count while the node is running.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 3,
            "spanNulls": false,
            "gradientMode": "none",
            "insertNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 205,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "100 * rate(utils_ElapsedMicrosec{container=\"ydb-dynamic\",database=~\"$database\",execpool=\"User\"}[$__rate_interval]) / 1000000 / clamp_min(avg_over_time(utils_CurrentThreadCount{container=\"ydb-dynamic\",database=~\"$database\",execpool=\"User\"}[$__rate_interval]), 1)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "User pool CPU по dynamic-узлам, %",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$ds"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 3,
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "id": 204,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "max by (object) (100 * ydb_tablet_cpu_cores{application=~\"$application\"})",
          "legendFormat": "{{object}}",
          "refId": "A"
        }
      ],
      "title": "Самая загруженная таблетка, %",
      "type": "timeseries",
      "description": "Максимальная загрузка отдельной таблетки в каждом объекте по .sys/partition_stats."
    },
    {
      "type": "timeseries",
      "title": "Партиции",
      "description": "Число рабочих партиций: основная таблица, таблица документов полнотекстового индекса и posting-таблица векторного индекса. Служебные таблицы индексов не суммируются.",
      "id": 209,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "pointSize": 3,
            "spanNulls": false,
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "sum(ydb_partition_count{application=~\"$application\",object=\"main\"})",
          "legendFormat": "основная таблица",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "sum(ydb_partition_count{application=~\"$application\",object=\"fulltext\",path=~\".*/indexImplDocsTable\"})",
          "legendFormat": "полнотекстовый индекс",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$ds"
          },
          "expr": "sum(ydb_partition_count{application=~\"$application\",object=\"vector\",path=~\".*/indexImplPostingTable\"})",
          "legendFormat": "векторный индекс",
          "refId": "C"
        }
      ]
    }
  ],
  "id": null,
  "uid": "deep-tech-search-demo",
  "title": "Deep Tech: YDB Search Demo",
  "tags": [
    "chaos",
    "demo",
    "search",
    "ydb"
  ],
  "description": "Компактный dashboard для демонстрации поиска, эластичности и инфраструктурных отказов.",
  "refresh": "5s"
}
