    {
      "datasource": {
        "type": "prometheus",
        "uid": "$ds"
      },
      "description": "User actor pool utilization divided by the dynamically allocated thread count. Auto-config may change that count while the node is running.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 3,
            "spanNulls": false,
            "gradientMode": "none",
            "insertNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
